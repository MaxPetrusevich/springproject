<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="02-create-relation-tables" author="your_name">
        <!-- Пользователи -->
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="identify_number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="image" type="BYTEA"/>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"
                           foreignKeyName="fk_user_role"
                           references="roles(id)"/>
            </column>
        </createTable>

        <!-- Граждане -->
        <createTable tableName="citizens">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="middle_name" type="VARCHAR(50)"/>
            <column name="identify_number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="phone" type="VARCHAR(20)"/>
            <column name="email" type="VARCHAR(100)"/>
            <column name="address" type="VARCHAR(255)"/>
        </createTable>

        <!-- Услуги -->
        <createTable tableName="services">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="category_id" type="BIGINT">
                <constraints nullable="false"
                           foreignKeyName="fk_service_category"
                           references="categories(id)"/>
            </column>
            <column name="establishment_id" type="BIGINT">
                <constraints nullable="false"
                           foreignKeyName="fk_service_establishment"
                           references="establishments(id)"/>
            </column>
        </createTable>

        <!-- Заявки -->
        <createTable tableName="bids">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="citizen_id" type="BIGINT">
                <constraints nullable="false"
                           foreignKeyName="fk_bid_citizen"
                           references="citizens(id)"/>
            </column>
            <column name="service_id" type="BIGINT">
                <constraints nullable="false"
                           foreignKeyName="fk_bid_service"
                           references="services(id)"/>
            </column>
            <column name="status_id" type="BIGINT">
                <constraints nullable="false"
                           foreignKeyName="fk_bid_status"
                           references="bid_statuses(id)"/>
            </column>
        </createTable>

        <!-- Платежи -->
        <createTable tableName="payments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sum" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="bid_id" type="BIGINT">
                <constraints nullable="false"
                           foreignKeyName="fk_payment_bid"
                           references="bids(id)"/>
            </column>
            <column name="status_id" type="BIGINT">
                <constraints nullable="false"
                           foreignKeyName="fk_payment_status"
                           references="payment_statuses(id)"/>
            </column>
        </createTable>

        <!-- Документы -->
        <createTable tableName="documents">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="file_path" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="original_filename" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="file_size" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="mime_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="loading_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="type_id" type="BIGINT">
                <constraints nullable="false"
                           foreignKeyName="fk_document_type"
                           references="types(id)"/>
            </column>
            <column name="bid_id" type="BIGINT">
                <constraints nullable="false"
                           foreignKeyName="fk_document_bid"
                           references="bids(id)"/>
            </column>
        </createTable>

        <!-- В таблице users -->
        <addForeignKeyConstraint baseTableName="users"
                                baseColumnNames="role_id"
                                constraintName="fk_users_role"
                                referencedTableName="roles"
                                referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog> 